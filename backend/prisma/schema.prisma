generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Category {
  id        String    @id
  name      String
  slug      String
  gender    String
  status    String
  createdAt DateTime
  updatedAt DateTime
  products  Product[]

  @@unique([gender, slug])
}

model Product {
  id             String   @id
  name           String
  slug           String   @unique
  description    String
  price          Decimal  @db.Decimal(10, 2)
  compareAtPrice Decimal? @db.Decimal(10, 2)
  gender         String
  categoryId     String
  category       Category @relation(fields: [categoryId], references: [id])
  sizes          String[]
  colors         String[]
  images         Json
  available      Boolean
  featured       Boolean
  sku            String?
  stock          Int?
  displayOrder   Int?
  createdAt      DateTime
  updatedAt      DateTime
}

model Banner {
  id           String   @id
  title        String
  subtitle     String
  imageUrl     String
  link         String
  placement    String
  active       Boolean
  displayOrder Int
  createdAt    DateTime
  updatedAt    DateTime
}

model Cart {
  id        String     @id
  createdAt DateTime
  items     CartItem[]
}

model CartItem {
  id        String  @id @default(uuid())
  cartId    String
  cart      Cart    @relation(fields: [cartId], references: [id], onDelete: Cascade)
  productId String
  name      String
  price     Decimal @db.Decimal(10, 2)
  size      String?
  color     String?
  imageUrl  String
}
